# Backend server
PORT=3001

# Native PostgreSQL on Windows
# Ganti postgres:postgres sesuai username/password PostgreSQL Anda.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cti?schema=public"

# Development secrets - change before production
JWT_ACCESS_SECRET="cti-dev-access-secret-change-me"
JWT_REFRESH_SECRET="cti-dev-refresh-secret-change-me"

FRONTEND_URL="http://localhost:3000"

# Threat intelligence community feeds
URLHAUS_AUTH_KEY=""
MALWAREBAZAAR_AUTH_KEY=""
ABUSEIPDB_API_KEY=""
# VirusTotal v3 enrichment (IP, domain, URL, and MD5/SHA-1/SHA-256 file hash).
VIRUSTOTAL_API_KEY=""
# Total VirusTotal request deadline in milliseconds (defaults to 15000).
VIRUSTOTAL_TIMEOUT_MS=15000
# Maximum indicators ingested from each provider per manual sync (1-500).
THREAT_FEED_ITEM_LIMIT=100
# Automatic feed sync interval in minutes. Defaults to 60 when omitted or invalid.
THREAT_FEED_SYNC_INTERVAL_MINUTES=60

# Automatic MITRE ATT&CK threat actor sync interval in minutes. Defaults to 1440 (24 hours).
MITRE_ATTACK_SYNC_INTERVAL_MINUTES=1440
