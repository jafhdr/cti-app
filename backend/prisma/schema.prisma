generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum StakeholderScope {
  INTERNAL
  EXTERNAL
}

enum StakeholderCategory {
  STRATEGIC
  OPERATIONAL
  TACTICAL
}

enum StakeholderType {
  INDIVIDUAL
  TEAM
  ORGANIZATION
}

enum PirPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PirStatus {
  OPEN
  IN_COLLECTION
  IN_ANALYSIS
  ANSWERED
  EXPIRED
}

enum CollectionMethod {
  MANUAL_RESEARCH
  INTELLIGENCE_FEED
  TELEGRAM_IOC
  INDICATOR_ENRICHMENT
  MITRE_ATTACK
}

enum CollectionTaskStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum CollectionResultKind {
  FINDINGS
  NO_FINDINGS
}

enum ApplicationCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum AppSecFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppSecFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum AppSecValidationState {
  PENDING
  VALID
  REJECTED
}

enum AppSecVerificationState {
  NONE
  REQUESTED
  REJECTED
  APPROVED
}

enum AppSecFindingPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppSecFindingSource {
  MANUAL
  SAST
  SCA
  DAST
  SECRET_SCAN
}

enum ModuleCategory {
  CTI
  APPSEC
  PLATFORM
}

enum IndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
}

enum IndicatorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum IndicatorSuppressionKind {
  FALSE_POSITIVE
  SAFELIST
}

enum IndicatorDecisionKind {
  FALSE_POSITIVE
  SAFELIST
  CLEAR
}

enum IndicatorEnrichmentStatus {
  SUCCESS
  FAILED
}

enum IndicatorEnrichmentJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum IntelligenceSourceType {
  OPEN_SOURCE
  COMMERCIAL
  GOVERNMENT
  COMMUNITY
  INTERNAL
}

enum IntelligenceSourceReliability {
  A
  B
  C
  D
  E
  F
}

enum TlpLevel {
  CLEAR
  GREEN
  AMBER
  AMBER_STRICT
  RED
}

enum TtpObservationStatus {
  CANDIDATE
  CONFIRMED
  DISPUTED
  REJECTED
}

enum TtpTimePrecision {
  INSTANT
  HOUR
  DAY
  INTERVAL
}

enum NextStepRunStatus {
  GENERATED
  ABSTAINED
}

enum NextStepReviewKind {
  DISPOSITION
  OUTCOME
}

enum NextStepDisposition {
  ACCEPT_FOR_INVESTIGATION
  DISMISSED
  ALREADY_OBSERVED
}

enum NextStepOutcome {
  VERIFIED
  UNCERTAIN
  UNOBSERVABLE
}

enum IntelligenceSourceStatus {
  ACTIVE
  INACTIVE
}

enum TelegramProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum IocCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IocCandidateType {
  IPV4
  IPV6
  DOMAIN
  URL
  MD5
  SHA1
  SHA256
}

enum ThreatActorStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MalwareToolType {
  MALWARE
  TOOL
}

enum IntelligenceReportType {
  STRATEGIC
  TACTICAL
  OPERATIONAL
  TECHNICAL
}

enum AnalysisConfidence {
  LOW
  MEDIUM
  HIGH
}

enum IntelligenceReportStatus {
  DRAFT
  IN_REVIEW
  FINAL
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum IntelligenceEntityType {
  SOURCE
  FEED
  THREAT_ACTOR
  CAMPAIGN
  MALWARE
  TOOL
  VULNERABILITY
  REPORT
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CaseOriginKind {
  MANUAL
  INDICATOR
  ASM_ALERT
  ASM_FINDING
  APPSEC_FINDING
}

enum CaseTaskState {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CaseReviewDecisionKind {
  APPROVED
  REJECTED
}

enum AssetType {
  DOMAIN
  SUBDOMAIN
  IP_ADDRESS
  HOST
  URL
  API
  CERTIFICATE
  CLOUD_ASSET
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum AssetRelationshipType {
  DISCOVERED_SUBDOMAIN
  RESOLVES_TO
}

enum AssetDiscoverySource {
  CLOUDFLARE_DOH
  CRT_SH
  DNS_RESOLUTION
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NetworkProtocol {
  TCP
  UDP
}

enum PortDiscoveryStatus {
  OPEN
  CLOSED
  FILTERED
  UNKNOWN
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum AsmRiskTrend {
  BASELINE
  INCREASED
  DECREASED
  UNCHANGED
}

enum SubscriptionPackageType {
  PREDEFINED
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Tenant {
  id                             String                            @id @default(cuid())
  monitoringWatchlists           MonitoringWatchlist[]
  monitoringSources              MonitoringSource[]
  monitoringObservations         MonitoringObservation[]
  monitoringFindings             MonitoringFinding[]
  monitoringReviews              MonitoringReview[]
  monitoringCollectionJobs       MonitoringCollectionJob[]
  threatEvents                   ThreatEvent[]
  threatCorrelations             ThreatCorrelation[]
  ttpObservations                TtpObservation[]
  ttpObservationReviews          TtpObservationReview[]
  nextStepRuns                   NextStepRun[]
  nextStepCandidates             NextStepCandidate[]
  nextStepReviews                NextStepReview[]
  playbookDefinitions            PlaybookDefinition[]
  playbookRuns                   PlaybookRun[]
  playbookSteps                  PlaybookStep[]
  playbookDecisions              PlaybookDecision[]
  playbookReceipts               PlaybookReceipt[]
  sandboxJobs                    SandboxConnectorJob[]
  sandboxEvents                  SandboxConnectorEvent[]
  correlationConnectorCredentials CorrelationConnectorCredential[]
  applications                   Application[]
  appSecFindings                 AppSecFinding[]
  notifications                  Notification[]
  notificationOutbox             NotificationOutbox[]
  name                           String
  slug                           String                            @unique
  isActive                       Boolean                           @default(true)
  deactivatedAt                  DateTime?
  createdAt                      DateTime                          @default(now())
  users                          User[]
  stakeholders                   Stakeholder[]
  pirs                           Pir[]
  sirs                           Sir[]
  sirEvidence                    SirEvidence[]
  collectionTasks                CollectionTask[]
  auditLogs                      AuditLog[]
  indicators                     Indicator[]
  indicatorDecisions             IndicatorDecision[]
  indicatorSourceObservations    IndicatorSourceObservation[]
  indicatorEnrichments           IndicatorEnrichment[]
  indicatorEnrichmentJobs        IndicatorEnrichmentJob[]
  intelligenceSources            IntelligenceSource[]
    sourceReliabilityAssessments SourceReliabilityAssessment[]
    evidenceCredibilityAssessments EvidenceCredibilityAssessment[]
  telegramStagingMessages        TelegramStagingMessage[]
  telegramPollingStates          TelegramPollingState[]
  iocCandidates                  IocCandidate[]
  iocObservations                IocObservation[]
  threatActors                   ThreatActor[]
  campaigns                      Campaign[]
  caseCampaigns                  CaseCampaign[]
  campaignIndicators             CampaignIndicator[]
  mitreTechniques                MitreTechnique[]
  campaignMitreTechniques        CampaignMitreTechnique[]
  malwareTools                   MalwareTool[]
  threatActorMalwareTools        ThreatActorMalwareTool[]
  campaignMalwareTools           CampaignMalwareTool[]
  vulnerabilities                Vulnerability[]
  assetVulnerabilityCorrelations AssetVulnerabilityCorrelation[]
  asmV2Enrollment                AsmV2Enrollment?
  asmCorrelationObservations     AsmCorrelationObservation[]
  asmCorrelationDecisions        AsmCorrelationDecision[]
  intelligenceReports            IntelligenceReport[]
  reportThreatActors             IntelligenceReportThreatActor[]
  reportCampaigns                IntelligenceReportCampaign[]
  reportIndicators               IntelligenceReportIndicator[]
  reportMalwareTools             IntelligenceReportMalwareTool[]
  reportVulnerabilities          IntelligenceReportVulnerability[]
  reportSources                  IntelligenceReportSource[]
  threatActorVulnerabilities     ThreatActorVulnerability[]
  campaignVulnerabilities        CampaignVulnerability[]
  malwareToolVulnerabilities     MalwareToolVulnerability[]
  intelligenceEntities           IntelligenceEntity[]
  intelligenceRelationships      IntelligenceRelationship[]
  intelligenceCases              Case[]
  caseOrigins                    CaseOrigin[]
  caseCreateRequests             CaseCreateRequest[]
  caseTasks                      CaseTask[]
  caseHandoffs                   CaseHandoff[]
  caseEvidenceRevisions          CaseEvidenceRevision[]
  caseReviewRequests             CaseReviewRequest[]
  caseReviewDecisions            CaseReviewDecision[]
  caseClosures                   CaseClosure[]
  caseReopens                    CaseReopen[]
  caseInvestigationNotes         CaseInvestigationNote[]
  caseEvidence                   CaseEvidence[]
  caseActivities                 CaseActivity[]
  caseIndicators                 CaseIndicator[]
  caseThreatActors               CaseThreatActor[]
  alerts                         Alert[]
  assets                         Asset[]
  assetRelationships             AssetRelationship[]
  assetPortServices              AssetPortService[]
  asmServiceFingerprintObservations AsmServiceFingerprintObservation[]
  assetFindings                  AssetFinding[]
  asmSchedules                   AsmDiscoverySchedule[]
  asmRuns                        AsmDiscoveryRun[]
  asmChanges                     AsmExposureChange[]
  asmRiskSnapshots               AsmRiskSnapshot[]
  asmNotifications               AsmNotification[]
  asmNotificationPreference      AsmNotificationPreference?
  moduleSettings                 TenantModule[]
  subscription                   TenantSubscription?
  userModuleAccess               UserModuleAccess[]
}

model AppModule {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  category            ModuleCategory
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            TenantModule[]
  packageModules      PackageModule[]
  features            ModuleFeature[]
  customSubscriptions TenantCustomModule[]
  userAccess          UserModuleAccess[]
}

model SubscriptionPackage {
  id            String                  @id @default(cuid())
  name          String                  @unique
  description   String?
  type          SubscriptionPackageType @default(PREDEFINED)
  billingCycle  BillingCycle            @default(MONTHLY)
  priceMonthly  Int
  priceYearly   Int?
  isActive      Boolean                 @default(true)
  modules       PackageModule[]
  subscriptions TenantSubscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PackageModule {
  packageId          String
  moduleId           String
  modulePriceMonthly Int?
  modulePriceYearly  Int?
  package            SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module             AppModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
}

model ModuleFeature {
  id          String    @id @default(cuid())
  moduleId    String
  key         String
  name        String
  description String?
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
}

model TenantSubscription {
  id            String               @id @default(cuid())
  tenantId      String               @unique
  packageId     String?
  isCustom      Boolean              @default(false)
  billingCycle  BillingCycle
  priceMonthly  Int
  priceYearly   Int?
  status        SubscriptionStatus   @default(TRIAL)
  subscribedAt  DateTime             @default(now())
  renewalAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customModules TenantCustomModule[]

  @@index([status, renewalAt])
}

model TenantCustomModule {
  subscriptionId String
  moduleId       String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module         AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, moduleId])
}

model TenantModule {
  id        String             @id @default(cuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  access    ModuleRoleAccess[]

  @@unique([tenantId, moduleId])
  @@index([tenantId, isEnabled])
}

model ModuleRoleAccess {
  id             String       @id @default(cuid())
  tenantModuleId String
  role           Role
  isAllowed      Boolean      @default(false)
  tenantModule   TenantModule @relation(fields: [tenantModuleId], references: [id], onDelete: Cascade)

  @@unique([tenantModuleId, role])
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  name                    String
  passwordHash            String
  sessionVersion          Int                     @default(0)
  role                    Role                    @default(USER)
  isActive                Boolean                 @default(true)
  deactivatedAt           DateTime?
  tenantId                String?
  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  moduleAccess            UserModuleAccess[]
  monitoringWatchlistsCreated MonitoringWatchlist[]
  monitoringReviews MonitoringReview[]
  responsibleStakeholders Stakeholder[]           @relation("StakeholderResponsible")
  createdStakeholders     Stakeholder[]           @relation("StakeholderCreator")
  updatedStakeholders     Stakeholder[]           @relation("StakeholderUpdater")
  responsiblePirs         Pir[]                   @relation("PirResponsible")
  createdPirs             Pir[]                   @relation("PirCreator")
  updatedPirs             Pir[]                   @relation("PirUpdater")
  responsibleSirs         Sir[]                   @relation("SirResponsible")
  createdSirs             Sir[]                   @relation("SirCreator")
  updatedSirs             Sir[]                   @relation("SirUpdater")
  createdSirEvidence      SirEvidence[]           @relation("SirEvidenceCreator")
  ttpObservationsCreated  TtpObservation[]        @relation("TtpObservationCreator")
  ttpObservationReviews   TtpObservationReview[]  @relation("TtpObservationReviewer")
  nextStepRunsCreated     NextStepRun[]           @relation("NextStepRunCreator")
  nextStepReviews         NextStepReview[]        @relation("NextStepReviewer")
  playbookRunsTriggered   PlaybookRun[]           @relation("PlaybookTrigger")
  playbookDecisions       PlaybookDecision[]
  playbookReceipts        PlaybookReceipt[]
  sandboxJobsRequested SandboxConnectorJob[] @relation("SandboxJobRequester")
  sourceReliabilityAssessments SourceReliabilityAssessment[] @relation("SourceReliabilityAssessor")
  evidenceCredibilityAssessments EvidenceCredibilityAssessment[] @relation("EvidenceCredibilityAssessor")
  assignedCollectionTasks CollectionTask[]        @relation("CollectionTaskResponsible")
  createdCollectionTasks  CollectionTask[]        @relation("CollectionTaskCreator")
  updatedCollectionTasks  CollectionTask[]        @relation("CollectionTaskUpdater")
  authSessions            AuthSession[]
  casesCreated            Case[]                  @relation("CaseCreator")
  casesAssigned           Case[]                  @relation("CaseAssignee")
  caseTasksAssigned       CaseTask[]              @relation("CaseTaskAssignee")
  caseTasksCreated        CaseTask[]              @relation("CaseTaskCreator")
  investigationNotes      CaseInvestigationNote[] @relation("CaseNoteAuthor")
  evidenceCreated         CaseEvidence[]          @relation("CaseEvidenceCreator")
  evidenceRevisionsAuthored CaseEvidenceRevision[] @relation("CaseEvidenceRevisionAuthor")
  caseReviewsRequested CaseReviewRequest[] @relation("CaseReviewRequestActor")
  caseReviewsAssigned CaseReviewRequest[] @relation("CaseReviewAssignee")
  caseReviewDecisions CaseReviewDecision[] @relation("CaseReviewDecisionActor")
  caseClosuresCreated CaseClosure[] @relation("CaseClosureActor")
  caseClosuresReviewed CaseClosure[] @relation("CaseClosureReviewer")
  caseReopensCreated CaseReopen[] @relation("CaseReopenActor")
  asmNotificationReads    AsmNotificationRead[]
  notificationRecipients  NotificationRecipient[]
  authoredAnalysisReports IntelligenceReport[] @relation("AnalysisReportAuthor")
  reviewedAnalysisReports IntelligenceReport[] @relation("AnalysisReportReviewer")
  sentDisseminations ReportDissemination[] @relation("ReportSender")
  receivedDisseminations ReportDissemination[] @relation("ReportRecipient")
  assignedFeedbackFollowUps FeedbackFollowUp[] @relation("FeedbackFollowUpAssignee")
  createdFeedbackFollowUps FeedbackFollowUp[] @relation("FeedbackFollowUpCreator")
  updatedFeedbackFollowUps FeedbackFollowUp[] @relation("FeedbackFollowUpUpdater")
  indicatorDecisions IndicatorDecision[] @relation("IndicatorDecisionActor")
  assignedAppSecFindings AppSecFinding[] @relation("AppSecFindingAssignee")
  appSecFindingActions AppSecFindingActionEvent[] @relation("AppSecFindingActionActor")
  asmCorrelationDecisions AsmCorrelationDecision[] @relation("AsmCorrelationDecisionActor")

  @@unique([id, tenantId])
}

model Stakeholder {
  id                       String              @id @default(cuid())
  tenantId                 String
  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                     String
  scope                    StakeholderScope
  category                 StakeholderCategory
  type                     StakeholderType
  responsibleUserId        String?
  responsibleUser          User?               @relation("StakeholderResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  description              String?
  intelligenceInterests    String?
  isActive                 Boolean             @default(true)
  reportingFormat          String?
  reportingFrequency       String?
  distributionChannel      String?
  classificationPreference TlpLevel?
  createdById              String
  createdBy                User                @relation("StakeholderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById              String
  updatedBy                User                @relation("StakeholderUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  pirs Pir[]
  analysisReports IntelligenceReport[]
  reportDisseminations ReportDissemination[]

  @@unique([id, tenantId])
  @@index([tenantId, category, isActive])
  @@index([tenantId, name])
  @@index([responsibleUserId, tenantId])
}

model Pir {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reference String
  title String
  question String
  description String?
  strategicContext String?
  stakeholderId String
  stakeholder Stakeholder @relation(fields: [stakeholderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  priority PirPriority @default(MEDIUM)
  status PirStatus @default(OPEN)
  responsibleUserId String?
  responsibleUser User? @relation("PirResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  timeHorizon String?
  dueDate DateTime?
  expectedOutcome String?
  createdById String
  createdBy User @relation("PirCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy User @relation("PirUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sirs Sir[]
  analysisReports IntelligenceReport[]
  feedbackFollowUps FeedbackFollowUp[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, stakeholderId])
  @@unique([tenantId, reference])
  @@index([tenantId, status, priority])
  @@index([stakeholderId, tenantId])
  @@index([responsibleUserId, tenantId])
  @@index([tenantId, dueDate])
}

model Sir {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pirId String
  pir Pir @relation(fields: [pirId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reference String
  title String
  question String
  description String?
  intelligenceContext String?
  knowledgeGaps String?
  collectionGuidance String?
  priority PirPriority @default(MEDIUM)
  status PirStatus @default(OPEN)
  responsibleUserId String?
  responsibleUser User? @relation("SirResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  dueDate DateTime?
  expectedAnswerCriteria String?
  analystAnswer String?
  evidenceNotes String?
  createdById String
  createdBy User @relation("SirCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy User @relation("SirUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence SirEvidence[]
  collectionTasks CollectionTask[]
  analysisReportSirs IntelligenceReportSir[]
  feedbackFollowUps FeedbackFollowUp[]

  @@unique([tenantId, reference])
  @@unique([id, tenantId, pirId])
  @@unique([id, tenantId])
  @@index([pirId, tenantId, status])
  @@index([tenantId, status, priority])
  @@index([responsibleUserId, tenantId])
  @@index([tenantId, dueDate])
}

model SirEvidence {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sirId String
  sir Sir @relation(fields: [sirId, tenantId], references: [id, tenantId], onDelete: Restrict)
  indicatorId String?
  indicator Indicator? @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  threatActorId String?
  threatActor ThreatActor? @relation(fields: [threatActorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relevanceNote String?
  createdById String
  createdBy User @relation("SirEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysisReportEvidence IntelligenceReportEvidence[]
  collectionTaskEvidence CollectionTaskEvidence[]
  credibilityAssessments EvidenceCredibilityAssessment[]
  ttpObservations TtpObservation[]

  @@unique([id, tenantId, sirId])
  @@unique([id, tenantId])
  @@unique([sirId, indicatorId])
  @@unique([sirId, threatActorId])
  @@unique([sirId, campaignId])
  @@index([tenantId, sirId])
}

model CollectionTask {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sirId String
  sir Sir @relation(fields: [sirId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reference String
  title String
  objective String
  informationRequired String
  method CollectionMethod
  sourceId String?
  source IntelligenceSource? @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  guidance String?
  priority PirPriority @default(MEDIUM)
  responsibleUserId String?
  responsibleUser User? @relation("CollectionTaskResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  dueDate DateTime?
  status CollectionTaskStatus @default(PLANNED)
  resultKind CollectionResultKind?
  resultSummary String?
  informationGaps String?
  completedAt DateTime?
  createdById String
  createdBy User @relation("CollectionTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy User @relation("CollectionTaskUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence CollectionTaskEvidence[]

  @@unique([tenantId, reference])
  @@unique([id, tenantId, sirId])
  @@index([tenantId, status, priority, dueDate])
  @@index([sirId, tenantId, status])
  @@index([responsibleUserId, tenantId])
  @@index([sourceId, tenantId])
}

model CollectionTaskEvidence {
  taskId String
  evidenceId String
  tenantId String
  sirId String
  task CollectionTask @relation(fields: [taskId, tenantId, sirId], references: [id, tenantId, sirId], onDelete: Restrict)
  evidence SirEvidence @relation(fields: [evidenceId, tenantId, sirId], references: [id, tenantId, sirId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([taskId, evidenceId])
  @@index([evidenceId, tenantId, sirId])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  version          Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
