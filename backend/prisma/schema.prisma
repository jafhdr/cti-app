generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ModuleCategory {
  CTI
  APPSEC
  PLATFORM
}

enum IndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
}

enum IndicatorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum IndicatorEnrichmentStatus {
  SUCCESS
  FAILED
}

enum IntelligenceSourceType {
  OPEN_SOURCE
  COMMERCIAL
  GOVERNMENT
  COMMUNITY
  INTERNAL
}

enum IntelligenceSourceReliability {
  A
  B
  C
  D
  E
  F
}

enum TlpLevel {
  CLEAR
  GREEN
  AMBER
  AMBER_STRICT
  RED
}

enum IntelligenceSourceStatus {
  ACTIVE
  INACTIVE
}

enum ThreatActorStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MalwareToolType {
  MALWARE
  TOOL
}

enum IntelligenceReportType {
  STRATEGIC
  TACTICAL
  OPERATIONAL
  TECHNICAL
}

enum IntelligenceReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum IntelligenceEntityType {
  SOURCE
  FEED
  THREAT_ACTOR
  CAMPAIGN
  MALWARE
  TOOL
  VULNERABILITY
  REPORT
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum SubscriptionPackageType {
  PREDEFINED
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Tenant {
  id                         String                     @id @default(cuid())
  name                       String
  slug                       String                     @unique
  isActive                   Boolean                    @default(true)
  deactivatedAt              DateTime?
  createdAt                  DateTime                   @default(now())
  users                      User[]
  auditLogs                  AuditLog[]
  indicators                 Indicator[]
  indicatorEnrichments       IndicatorEnrichment[]
  intelligenceSources        IntelligenceSource[]
  threatActors               ThreatActor[]
  campaigns                  Campaign[]
  campaignIndicators         CampaignIndicator[]
  mitreTechniques            MitreTechnique[]
  campaignMitreTechniques    CampaignMitreTechnique[]
  malwareTools               MalwareTool[]
  threatActorMalwareTools    ThreatActorMalwareTool[]
  campaignMalwareTools       CampaignMalwareTool[]
  vulnerabilities            Vulnerability[]
  intelligenceReports        IntelligenceReport[]
  reportThreatActors         IntelligenceReportThreatActor[]
  reportCampaigns            IntelligenceReportCampaign[]
  reportIndicators           IntelligenceReportIndicator[]
  reportMalwareTools         IntelligenceReportMalwareTool[]
  reportVulnerabilities      IntelligenceReportVulnerability[]
  reportSources              IntelligenceReportSource[]
  threatActorVulnerabilities ThreatActorVulnerability[]
  campaignVulnerabilities    CampaignVulnerability[]
  malwareToolVulnerabilities MalwareToolVulnerability[]
  intelligenceEntities       IntelligenceEntity[]
  intelligenceRelationships  IntelligenceRelationship[]
  intelligenceCases          Case[]
  caseInvestigationNotes     CaseInvestigationNote[]
  caseEvidence               CaseEvidence[]
  caseActivities             CaseActivity[]
  alerts                     Alert[]
  moduleSettings             TenantModule[]
  subscription               TenantSubscription?
  userModuleAccess           UserModuleAccess[]
}

model AppModule {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  category            ModuleCategory
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            TenantModule[]
  packageModules      PackageModule[]
  features            ModuleFeature[]
  customSubscriptions TenantCustomModule[]
  userAccess          UserModuleAccess[]
}

model SubscriptionPackage {
  id            String                  @id @default(cuid())
  name          String                  @unique
  description   String?
  type          SubscriptionPackageType @default(PREDEFINED)
  billingCycle  BillingCycle            @default(MONTHLY)
  priceMonthly  Int
  priceYearly   Int?
  isActive      Boolean                 @default(true)
  modules       PackageModule[]
  subscriptions TenantSubscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PackageModule {
  packageId          String
  moduleId           String
  modulePriceMonthly Int?
  modulePriceYearly  Int?
  package            SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module             AppModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
}

model ModuleFeature {
  id          String    @id @default(cuid())
  moduleId    String
  key         String
  name        String
  description String?
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
}

model TenantSubscription {
  id            String               @id @default(cuid())
  tenantId      String               @unique
  packageId     String?
  isCustom      Boolean              @default(false)
  billingCycle  BillingCycle
  priceMonthly  Int
  priceYearly   Int?
  status        SubscriptionStatus   @default(TRIAL)
  subscribedAt  DateTime             @default(now())
  renewalAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customModules TenantCustomModule[]

  @@index([status, renewalAt])
}

model TenantCustomModule {
  subscriptionId String
  moduleId       String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module         AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, moduleId])
}

model TenantModule {
  id        String             @id @default(cuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  access    ModuleRoleAccess[]

  @@unique([tenantId, moduleId])
  @@index([tenantId, isEnabled])
}

model ModuleRoleAccess {
  id             String       @id @default(cuid())
  tenantModuleId String
  role           Role
  isAllowed      Boolean      @default(false)
  tenantModule   TenantModule @relation(fields: [tenantModuleId], references: [id], onDelete: Cascade)

  @@unique([tenantModuleId, role])
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String
  passwordHash     String
  role             Role               @default(USER)
  isActive         Boolean            @default(true)
  deactivatedAt    DateTime?
  tenantId         String?
  tenant           Tenant?            @relation(fields: [tenantId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  moduleAccess     UserModuleAccess[]
  casesCreated     Case[]             @relation("CaseCreator")
  casesAssigned    Case[]             @relation("CaseAssignee")
  investigationNotes CaseInvestigationNote[] @relation("CaseNoteAuthor")
  evidenceCreated  CaseEvidence[]     @relation("CaseEvidenceCreator")
}

model UserModuleAccess {
  userId      String
  tenantId    String
  moduleId    String
  featureKeys String[]  @default([])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, moduleId])
  @@index([tenantId, moduleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Indicator {
  id                   String              @id @default(cuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value                String
  type                 IndicatorType
  severity             IndicatorSeverity   @default(MEDIUM)
  confidence           Int                 @default(50)
  status               IndicatorStatus     @default(ACTIVE)
  tags                 String[]            @default([])
  source               String?
  intelligenceSourceId String?
  intelligenceSource   IntelligenceSource? @relation(fields: [intelligenceSourceId], references: [id], onDelete: SetNull)
  description          String?
  expiresAt            DateTime?
  createdById          String?
  intelligenceEntityId String?
  intelligenceEntity   IntelligenceEntity? @relation(fields: [intelligenceEntityId], references: [id], onDelete: SetNull)
  campaigns            CampaignIndicator[]
  intelligenceReports  IntelligenceReportIndicator[]
  enrichments          IndicatorEnrichment[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, type, value])
  @@unique([id, tenantId])
  @@index([tenantId, status, severity])
  @@index([tenantId, createdAt])
  @@index([tenantId, intelligenceEntityId])
  @@index([tenantId, intelligenceSourceId])
}

model IndicatorEnrichment {
  id          String                    @id @default(cuid())
  tenantId    String
  indicatorId String
  provider    String
  data        Json?
  status      IndicatorEnrichmentStatus
  error       String?
  createdAt   DateTime                  @default(now())
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicator   Indicator                 @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, indicatorId, createdAt])
}

model IntelligenceSource {
  id          String                        @id @default(cuid())
  tenantId    String
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sourceType  IntelligenceSourceType
  provider    String?
  url         String?
  reliability IntelligenceSourceReliability @default(C)
  confidence  Int                           @default(50)
  tlp         TlpLevel                      @default(AMBER)
  status      IntelligenceSourceStatus      @default(ACTIVE)
  lastSyncAt  DateTime?
  createdBy   String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  indicators  Indicator[]
  intelligenceReports IntelligenceReportSource[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, sourceType, status, tlp])
  @@index([tenantId, updatedAt])
}

model IntelligenceEntity {
  id                    String                     @id @default(cuid())
  tenantId              String
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  IntelligenceEntityType
  name                  String
  description           String?
  externalId            String?
  confidence            Int                        @default(50)
  severity              IndicatorSeverity          @default(MEDIUM)
  metadata              Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  outgoingRelationships IntelligenceRelationship[] @relation("RelationshipSource")
  incomingRelationships IntelligenceRelationship[] @relation("RelationshipTarget")
  caseLinks             CaseEntity[]
  alertLinks            AlertEntity[]
  indicators            Indicator[]
  threatActor           ThreatActor?

  @@unique([tenantId, type, name])
  @@index([tenantId, type, severity])
}

model ThreatActor {
  id              String                     @id @default(cuid())
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityId        String                     @unique
  entity          IntelligenceEntity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  aliases         String[]                   @default([])
  motivation      String?
  targetSectors   String[]                   @default([])
  country         String?
  region          String?
  status          ThreatActorStatus          @default(ACTIVE)
  createdBy       String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  campaigns       Campaign[]
  malwareTools    ThreatActorMalwareTool[]
  vulnerabilities ThreatActorVulnerability[]
  intelligenceReports IntelligenceReportThreatActor[]

  @@unique([tenantId, entityId])
  @@unique([id, tenantId])
  @@index([tenantId, status, updatedAt])
}

model Campaign {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  objective       String?
  status          CampaignStatus           @default(PLANNED)
  severity        IndicatorSeverity        @default(MEDIUM)
  confidence      Int                      @default(50)
  startDate       DateTime?
  endDate         DateTime?
  externalId      String?
  referenceUrl    String?
  threatActorId   String
  threatActor     ThreatActor              @relation(fields: [threatActorId], references: [id], onDelete: Restrict)
  indicators      CampaignIndicator[]
  mitreTechniques CampaignMitreTechnique[]
  malwareTools    CampaignMalwareTool[]
  vulnerabilities CampaignVulnerability[]
  intelligenceReports IntelligenceReportCampaign[]
  createdBy       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, status, severity, updatedAt])
  @@index([tenantId, threatActorId])
}

model MalwareTool {
  id              String                     @id @default(cuid())
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  type            MalwareToolType
  description     String?
  externalId      String?
  url             String?
  threatActors    ThreatActorMalwareTool[]
  campaigns       CampaignMalwareTool[]
  vulnerabilities MalwareToolVulnerability[]
  intelligenceReports IntelligenceReportMalwareTool[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, type, updatedAt])
}

model Vulnerability {
  id           String                     @id @default(cuid())
  tenantId     String
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cveId        String
  name         String
  description  String?
  severity     IndicatorSeverity          @default(MEDIUM)
  cvssScore    Float?
  url          String?
  threatActors ThreatActorVulnerability[]
  campaigns    CampaignVulnerability[]
  malwareTools MalwareToolVulnerability[]
  intelligenceReports IntelligenceReportVulnerability[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([tenantId, cveId])
  @@unique([id, tenantId])
  @@index([tenantId, severity, updatedAt])
}

model IntelligenceReport {
  id              String                            @id @default(cuid())
  tenantId        String
  tenant          Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  summary         String
  content         String
  reportType      IntelligenceReportType
  tlp             TlpLevel                          @default(AMBER)
  status          IntelligenceReportStatus          @default(DRAFT)
  publishedAt     DateTime?
  threatActors    IntelligenceReportThreatActor[]
  campaigns       IntelligenceReportCampaign[]
  indicators      IntelligenceReportIndicator[]
  malwareTools    IntelligenceReportMalwareTool[]
  vulnerabilities IntelligenceReportVulnerability[]
  sources         IntelligenceReportSource[]
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([tenantId, title])
  @@unique([id, tenantId])
  @@index([tenantId, status, reportType, updatedAt])
  @@index([tenantId, publishedAt])
}

model IntelligenceReportThreatActor {
  reportId      String
  threatActorId String
  tenantId      String
  report        IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  threatActor   ThreatActor        @relation(fields: [threatActorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  @@id([reportId, threatActorId])
  @@index([tenantId, threatActorId])
}

model IntelligenceReportCampaign {
  reportId  String
  campaignId String
  tenantId  String
  report    IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  campaign  Campaign           @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  @@id([reportId, campaignId])
  @@index([tenantId, campaignId])
}

model IntelligenceReportIndicator {
  reportId   String
  indicatorId String
  tenantId   String
  report     IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  indicator  Indicator          @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  @@id([reportId, indicatorId])
  @@index([tenantId, indicatorId])
}

model IntelligenceReportMalwareTool {
  reportId     String
  malwareToolId String
  tenantId     String
  report       IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  malwareTool  MalwareTool        @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  @@id([reportId, malwareToolId])
  @@index([tenantId, malwareToolId])
}

model IntelligenceReportVulnerability {
  reportId        String
  vulnerabilityId String
  tenantId        String
  report          IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  vulnerability   Vulnerability      @relation(fields: [vulnerabilityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  @@id([reportId, vulnerabilityId])
  @@index([tenantId, vulnerabilityId])
}

model IntelligenceReportSource {
  reportId  String
  sourceId  String
  tenantId  String
  report    IntelligenceReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Cascade)
  source    IntelligenceSource @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  @@id([reportId, sourceId])
  @@index([tenantId, sourceId])
}

model ThreatActorVulnerability {
  threatActorId   String
  vulnerabilityId String
  tenantId        String
  threatActor     ThreatActor   @relation(fields: [threatActorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([threatActorId, vulnerabilityId])
  @@index([tenantId, vulnerabilityId])
}

model CampaignVulnerability {
  campaignId      String
  vulnerabilityId String
  tenantId        String
  campaign        Campaign      @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([campaignId, vulnerabilityId])
  @@index([tenantId, vulnerabilityId])
}

model MalwareToolVulnerability {
  malwareToolId   String
  vulnerabilityId String
  tenantId        String
  malwareTool     MalwareTool   @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([malwareToolId, vulnerabilityId])
  @@index([tenantId, vulnerabilityId])
}

model ThreatActorMalwareTool {
  threatActorId String
  malwareToolId String
  tenantId      String
  threatActor   ThreatActor @relation(fields: [threatActorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  malwareTool   MalwareTool @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([threatActorId, malwareToolId])
  @@index([tenantId, malwareToolId])
}

model CampaignMalwareTool {
  campaignId    String
  malwareToolId String
  tenantId      String
  campaign      Campaign    @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  malwareTool   MalwareTool @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([campaignId, malwareToolId])
  @@index([tenantId, malwareToolId])
}

model MitreTechnique {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  description String?
  tactic      String
  platform    String
  url         String?
  campaigns   CampaignMitreTechnique[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([tenantId, externalId])
  @@unique([id, tenantId])
  @@index([tenantId, tactic, platform])
  @@index([tenantId, updatedAt])
}

model CampaignMitreTechnique {
  campaignId       String
  mitreTechniqueId String
  tenantId         String
  campaign         Campaign       @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  mitreTechnique   MitreTechnique @relation(fields: [mitreTechniqueId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([campaignId, mitreTechniqueId])
  @@index([tenantId, mitreTechniqueId])
}

model CampaignIndicator {
  campaignId  String
  indicatorId String
  tenantId    String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([campaignId, indicatorId])
  @@index([tenantId, indicatorId])
}

model IntelligenceRelationship {
  id               String             @id @default(cuid())
  tenantId         String
  sourceId         String
  targetId         String
  relationshipType String
  description      String?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           IntelligenceEntity @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target           IntelligenceEntity @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@unique([tenantId, sourceId, targetId, relationshipType])
  @@index([tenantId, sourceId])
  @@index([tenantId, targetId])
}

model Case {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseNumber  String
  title       String
  description String?
  status      CaseStatus        @default(OPEN)
  priority    CasePriority      @default(MEDIUM)
  severity    IndicatorSeverity @default(MEDIUM)
  assigneeId  String?
  assignee    User?             @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   String
  creator     User              @relation("CaseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entities    CaseEntity[]
  alerts      Alert[]
  investigationNotes CaseInvestigationNote[]
  evidence    CaseEvidence[]
  activities  CaseActivity[]

  @@unique([tenantId, caseNumber])
  @@unique([id, tenantId])
  @@index([tenantId, status, priority, severity])
  @@index([tenantId, createdAt])
}

model CaseInvestigationNote {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case      Case     @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  author    User     @relation("CaseNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, createdAt])
}

model CaseEvidence {
  id          String   @id @default(cuid())
  tenantId    String
  caseId      String
  name        String
  type        String
  description String?
  source      String?
  createdBy   String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case        Case     @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  creator     User     @relation("CaseEvidenceCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, createdAt])
}

model CaseActivity {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case      Case     @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, caseId, createdAt])
}

model CaseEntity {
  caseId   String
  entityId String
  case     Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entity   IntelligenceEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([caseId, entityId])
}

model Alert {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      AlertStatus       @default(OPEN)
  severity    IndicatorSeverity @default(MEDIUM)
  caseId      String?
  case        Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entities    AlertEntity[]

  @@index([tenantId, status, severity])
}

model AlertEntity {
  alertId  String
  entityId String
  alert    Alert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  entity   IntelligenceEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([alertId, entityId])
}
