generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ModuleCategory {
  CTI
  APPSEC
  PLATFORM
}

enum IndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
}

enum IndicatorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum IntelligenceSourceType {
  OPEN_SOURCE
  COMMERCIAL
  GOVERNMENT
  COMMUNITY
  INTERNAL
}

enum IntelligenceSourceReliability {
  A
  B
  C
  D
  E
  F
}

enum TlpLevel {
  CLEAR
  GREEN
  AMBER
  AMBER_STRICT
  RED
}

enum IntelligenceSourceStatus {
  ACTIVE
  INACTIVE
}

enum ThreatActorStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MalwareToolType {
  MALWARE
  TOOL
}

enum IntelligenceEntityType {
  SOURCE
  FEED
  THREAT_ACTOR
  CAMPAIGN
  MALWARE
  TOOL
  VULNERABILITY
  REPORT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum SubscriptionPackageType {
  PREDEFINED
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Tenant {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  isActive                  Boolean                    @default(true)
  deactivatedAt             DateTime?
  createdAt                 DateTime                   @default(now())
  users                     User[]
  auditLogs                 AuditLog[]
  indicators                Indicator[]
  intelligenceSources       IntelligenceSource[]
  threatActors              ThreatActor[]
  campaigns                 Campaign[]
  campaignIndicators        CampaignIndicator[]
  mitreTechniques           MitreTechnique[]
  campaignMitreTechniques   CampaignMitreTechnique[]
  malwareTools              MalwareTool[]
  threatActorMalwareTools   ThreatActorMalwareTool[]
  campaignMalwareTools      CampaignMalwareTool[]
  intelligenceEntities      IntelligenceEntity[]
  intelligenceRelationships IntelligenceRelationship[]
  intelligenceCases         Case[]
  alerts                    Alert[]
  moduleSettings            TenantModule[]
  subscription              TenantSubscription?
  userModuleAccess          UserModuleAccess[]
}

model AppModule {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  category            ModuleCategory
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            TenantModule[]
  packageModules      PackageModule[]
  features            ModuleFeature[]
  customSubscriptions TenantCustomModule[]
  userAccess          UserModuleAccess[]
}

model SubscriptionPackage {
  id            String                  @id @default(cuid())
  name          String                  @unique
  description   String?
  type          SubscriptionPackageType @default(PREDEFINED)
  billingCycle  BillingCycle            @default(MONTHLY)
  priceMonthly  Int
  priceYearly   Int?
  isActive      Boolean                 @default(true)
  modules       PackageModule[]
  subscriptions TenantSubscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PackageModule {
  packageId          String
  moduleId           String
  modulePriceMonthly Int?
  modulePriceYearly  Int?
  package            SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module             AppModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
}

model ModuleFeature {
  id          String    @id @default(cuid())
  moduleId    String
  key         String
  name        String
  description String?
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
}

model TenantSubscription {
  id            String               @id @default(cuid())
  tenantId      String               @unique
  packageId     String?
  isCustom      Boolean              @default(false)
  billingCycle  BillingCycle
  priceMonthly  Int
  priceYearly   Int?
  status        SubscriptionStatus   @default(TRIAL)
  subscribedAt  DateTime             @default(now())
  renewalAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customModules TenantCustomModule[]

  @@index([status, renewalAt])
}

model TenantCustomModule {
  subscriptionId String
  moduleId       String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module         AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, moduleId])
}

model TenantModule {
  id        String             @id @default(cuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  access    ModuleRoleAccess[]

  @@unique([tenantId, moduleId])
  @@index([tenantId, isEnabled])
}

model ModuleRoleAccess {
  id             String       @id @default(cuid())
  tenantModuleId String
  role           Role
  isAllowed      Boolean      @default(false)
  tenantModule   TenantModule @relation(fields: [tenantModuleId], references: [id], onDelete: Cascade)

  @@unique([tenantModuleId, role])
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String
  passwordHash  String
  role          Role               @default(USER)
  isActive      Boolean            @default(true)
  deactivatedAt DateTime?
  tenantId      String?
  tenant        Tenant?            @relation(fields: [tenantId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  moduleAccess  UserModuleAccess[]
}

model UserModuleAccess {
  userId      String
  tenantId    String
  moduleId    String
  featureKeys String[]  @default([])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, moduleId])
  @@index([tenantId, moduleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Indicator {
  id                   String              @id @default(cuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value                String
  type                 IndicatorType
  severity             IndicatorSeverity   @default(MEDIUM)
  confidence           Int                 @default(50)
  status               IndicatorStatus     @default(ACTIVE)
  tags                 String[]            @default([])
  source               String?
  intelligenceSourceId String?
  intelligenceSource   IntelligenceSource? @relation(fields: [intelligenceSourceId], references: [id], onDelete: SetNull)
  description          String?
  expiresAt            DateTime?
  createdById          String?
  intelligenceEntityId String?
  intelligenceEntity   IntelligenceEntity? @relation(fields: [intelligenceEntityId], references: [id], onDelete: SetNull)
  campaigns            CampaignIndicator[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, type, value])
  @@index([tenantId, status, severity])
  @@index([tenantId, createdAt])
  @@index([tenantId, intelligenceEntityId])
  @@index([tenantId, intelligenceSourceId])
}

model IntelligenceSource {
  id          String                        @id @default(cuid())
  tenantId    String
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sourceType  IntelligenceSourceType
  provider    String?
  url         String?
  reliability IntelligenceSourceReliability @default(C)
  confidence  Int                           @default(50)
  tlp         TlpLevel                      @default(AMBER)
  status      IntelligenceSourceStatus      @default(ACTIVE)
  lastSyncAt  DateTime?
  createdBy   String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  indicators  Indicator[]

  @@unique([tenantId, name])
  @@index([tenantId, sourceType, status, tlp])
  @@index([tenantId, updatedAt])
}

model IntelligenceEntity {
  id                    String                     @id @default(cuid())
  tenantId              String
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  IntelligenceEntityType
  name                  String
  description           String?
  externalId            String?
  confidence            Int                        @default(50)
  severity              IndicatorSeverity          @default(MEDIUM)
  metadata              Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  outgoingRelationships IntelligenceRelationship[] @relation("RelationshipSource")
  incomingRelationships IntelligenceRelationship[] @relation("RelationshipTarget")
  caseLinks             CaseEntity[]
  alertLinks            AlertEntity[]
  indicators            Indicator[]
  threatActor           ThreatActor?

  @@unique([tenantId, type, name])
  @@index([tenantId, type, severity])
}

model ThreatActor {
  id            String                   @id @default(cuid())
  tenantId      String
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityId      String                   @unique
  entity        IntelligenceEntity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  aliases       String[]                 @default([])
  motivation    String?
  targetSectors String[]                 @default([])
  country       String?
  region        String?
  status        ThreatActorStatus        @default(ACTIVE)
  createdBy     String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  campaigns     Campaign[]
  malwareTools  ThreatActorMalwareTool[]

  @@unique([tenantId, entityId])
  @@unique([id, tenantId])
  @@index([tenantId, status, updatedAt])
}

model Campaign {
  id              String                   @id @default(cuid())
  tenantId        String
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  objective       String?
  status          CampaignStatus           @default(PLANNED)
  severity        IndicatorSeverity        @default(MEDIUM)
  confidence      Int                      @default(50)
  startDate       DateTime?
  endDate         DateTime?
  externalId      String?
  referenceUrl    String?
  threatActorId   String
  threatActor     ThreatActor              @relation(fields: [threatActorId], references: [id], onDelete: Restrict)
  indicators      CampaignIndicator[]
  mitreTechniques CampaignMitreTechnique[]
  malwareTools    CampaignMalwareTool[]
  createdBy       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, status, severity, updatedAt])
  @@index([tenantId, threatActorId])
}

model MalwareTool {
  id           String                   @id @default(cuid())
  tenantId     String
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  type         MalwareToolType
  description  String?
  externalId   String?
  url          String?
  threatActors ThreatActorMalwareTool[]
  campaigns    CampaignMalwareTool[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, type, updatedAt])
}

model ThreatActorMalwareTool {
  threatActorId String
  malwareToolId String
  tenantId      String
  threatActor   ThreatActor @relation(fields: [threatActorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  malwareTool   MalwareTool @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([threatActorId, malwareToolId])
  @@index([tenantId, malwareToolId])
}

model CampaignMalwareTool {
  campaignId    String
  malwareToolId String
  tenantId      String
  campaign      Campaign    @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  malwareTool   MalwareTool @relation(fields: [malwareToolId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([campaignId, malwareToolId])
  @@index([tenantId, malwareToolId])
}

model MitreTechnique {
  id          String                   @id @default(cuid())
  tenantId    String
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  description String?
  tactic      String
  platform    String
  url         String?
  campaigns   CampaignMitreTechnique[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([tenantId, externalId])
  @@unique([id, tenantId])
  @@index([tenantId, tactic, platform])
  @@index([tenantId, updatedAt])
}

model CampaignMitreTechnique {
  campaignId       String
  mitreTechniqueId String
  tenantId         String
  campaign         Campaign       @relation(fields: [campaignId, tenantId], references: [id, tenantId], onDelete: Cascade)
  mitreTechnique   MitreTechnique @relation(fields: [mitreTechniqueId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([campaignId, mitreTechniqueId])
  @@index([tenantId, mitreTechniqueId])
}

model CampaignIndicator {
  campaignId  String
  indicatorId String
  tenantId    String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([campaignId, indicatorId])
  @@index([tenantId, indicatorId])
}

model IntelligenceRelationship {
  id               String             @id @default(cuid())
  tenantId         String
  sourceId         String
  targetId         String
  relationshipType String
  description      String?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           IntelligenceEntity @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target           IntelligenceEntity @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@unique([tenantId, sourceId, targetId, relationshipType])
  @@index([tenantId, sourceId])
  @@index([tenantId, targetId])
}

model Case {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      CaseStatus        @default(OPEN)
  severity    IndicatorSeverity @default(MEDIUM)
  ownerId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entities    CaseEntity[]
  alerts      Alert[]

  @@index([tenantId, status, severity])
}

model CaseEntity {
  caseId   String
  entityId String
  case     Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entity   IntelligenceEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([caseId, entityId])
}

model Alert {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      AlertStatus       @default(OPEN)
  severity    IndicatorSeverity @default(MEDIUM)
  caseId      String?
  case        Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entities    AlertEntity[]

  @@index([tenantId, status, severity])
}

model AlertEntity {
  alertId  String
  entityId String
  alert    Alert              @relation(fields: [alertId], references: [id], onDelete: Cascade)
  entity   IntelligenceEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([alertId, entityId])
}
