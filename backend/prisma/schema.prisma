generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ApplicationCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum AppSecFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppSecFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED_RISK
  FALSE_POSITIVE
}

enum AppSecFindingSource {
  MANUAL
  SAST
  SCA
  DAST
  SECRET_SCAN
}

enum ModuleCategory {
  CTI
  APPSEC
  PLATFORM
}

enum IndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
}

enum IndicatorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum IndicatorEnrichmentStatus {
  SUCCESS
  FAILED
}

enum IndicatorEnrichmentJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum IntelligenceSourceType {
  OPEN_SOURCE
  COMMERCIAL
  GOVERNMENT
  COMMUNITY
  INTERNAL
}

enum IntelligenceSourceReliability {
  A
  B
  C
  D
  E
  F
}

enum TlpLevel {
  CLEAR
  GREEN
  AMBER
  AMBER_STRICT
  RED
}

enum IntelligenceSourceStatus {
  ACTIVE
  INACTIVE
}

enum TelegramProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum IocCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IocCandidateType {
  IPV4
  IPV6
  DOMAIN
  URL
  MD5
  SHA1
  SHA256
}

enum ThreatActorStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MalwareToolType {
  MALWARE
  TOOL
}

enum IntelligenceReportType {
  STRATEGIC
  TACTICAL
  OPERATIONAL
  TECHNICAL
}

enum IntelligenceReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum IntelligenceEntityType {
  SOURCE
  FEED
  THREAT_ACTOR
  CAMPAIGN
  MALWARE
  TOOL
  VULNERABILITY
  REPORT
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AssetType {
  DOMAIN
  SUBDOMAIN
  IP_ADDRESS
  HOST
  URL
  API
  CERTIFICATE
  CLOUD_ASSET
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum AssetRelationshipType {
  DISCOVERED_SUBDOMAIN
  RESOLVES_TO
}

enum AssetDiscoverySource {
  CLOUDFLARE_DOH
  CRT_SH
  DNS_RESOLUTION
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetFindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NetworkProtocol {
  TCP
  UDP
}

enum PortDiscoveryStatus {
  OPEN
  CLOSED
  FILTERED
  UNKNOWN
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum AsmRiskTrend {
  BASELINE
  INCREASED
  DECREASED
  UNCHANGED
}

enum SubscriptionPackageType {
  PREDEFINED
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Tenant {
  id                         String                            @id @default(cuid())
  applications               Application[]
  appSecFindings             AppSecFinding[]
  notifications              Notification[]
  notificationOutbox          NotificationOutbox[]
  name                       String
  slug                       String                            @unique
  isActive                   Boolean                           @default(true)
  deactivatedAt              DateTime?
  createdAt                  DateTime                          @default(now())
  users                      User[]
  auditLogs                  AuditLog[]
  indicators                 Indicator[]
  indicatorSourceObservations IndicatorSourceObservation[]
  indicatorEnrichments       IndicatorEnrichment[]
  indicatorEnrichmentJobs    IndicatorEnrichmentJob[]
  intelligenceSources        IntelligenceSource[]
  telegramStagingMessages    TelegramStagingMessage[]
  telegramPollingStates      TelegramPollingState[]
  iocCandidates              IocCandidate[]
  iocObservations            IocObservation[]
  threatActors               ThreatActor[]
  campaigns                  Campaign[]
  caseCampaigns              CaseCampaign[]
  campaignIndicators         CampaignIndicator[]
  mitreTechniques            MitreTechnique[]
  campaignMitreTechniques    CampaignMitreTechnique[]
  malwareTools               MalwareTool[]
  threatActorMalwareTools    ThreatActorMalwareTool[]
  campaignMalwareTools       CampaignMalwareTool[]
  vulnerabilities            Vulnerability[]
  assetVulnerabilityCorrelations AssetVulnerabilityCorrelation[]
  intelligenceReports        IntelligenceReport[]
  reportThreatActors         IntelligenceReportThreatActor[]
  reportCampaigns            IntelligenceReportCampaign[]
  reportIndicators           IntelligenceReportIndicator[]
  reportMalwareTools         IntelligenceReportMalwareTool[]
  reportVulnerabilities      IntelligenceReportVulnerability[]
  reportSources              IntelligenceReportSource[]
  threatActorVulnerabilities ThreatActorVulnerability[]
  campaignVulnerabilities    CampaignVulnerability[]
  malwareToolVulnerabilities MalwareToolVulnerability[]
  intelligenceEntities       IntelligenceEntity[]
  intelligenceRelationships  IntelligenceRelationship[]
  intelligenceCases          Case[]
  caseInvestigationNotes     CaseInvestigationNote[]
  caseEvidence               CaseEvidence[]
  caseActivities             CaseActivity[]
  caseIndicators             CaseIndicator[]
  caseThreatActors           CaseThreatActor[]
  alerts                     Alert[]
  assets                     Asset[]
  assetRelationships         AssetRelationship[]
  assetPortServices          AssetPortService[]
  assetFindings              AssetFinding[]
  asmSchedules               AsmDiscoverySchedule[]
  asmRuns                    AsmDiscoveryRun[]
  asmChanges                 AsmExposureChange[]
  asmRiskSnapshots           AsmRiskSnapshot[]
  asmNotifications           AsmNotification[]
  asmNotificationPreference  AsmNotificationPreference?
  moduleSettings             TenantModule[]
  subscription               TenantSubscription?
  userModuleAccess           UserModuleAccess[]
}

model AppModule {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  category            ModuleCategory
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            TenantModule[]
  packageModules      PackageModule[]
  features            ModuleFeature[]
  customSubscriptions TenantCustomModule[]
  userAccess          UserModuleAccess[]
}

model SubscriptionPackage {
  id            String                  @id @default(cuid())
  name          String                  @unique
  description   String?
  type          SubscriptionPackageType @default(PREDEFINED)
  billingCycle  BillingCycle            @default(MONTHLY)
  priceMonthly  Int
  priceYearly   Int?
  isActive      Boolean                 @default(true)
  modules       PackageModule[]
  subscriptions TenantSubscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model PackageModule {
  packageId          String
  moduleId           String
  modulePriceMonthly Int?
  modulePriceYearly  Int?
  package            SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module             AppModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
}

model ModuleFeature {
  id          String    @id @default(cuid())
  moduleId    String
  key         String
  name        String
  description String?
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
}

model TenantSubscription {
  id            String               @id @default(cuid())
  tenantId      String               @unique
  packageId     String?
  isCustom      Boolean              @default(false)
  billingCycle  BillingCycle
  priceMonthly  Int
  priceYearly   Int?
  status        SubscriptionStatus   @default(TRIAL)
  subscribedAt  DateTime             @default(now())
  renewalAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  package       SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customModules TenantCustomModule[]

  @@index([status, renewalAt])
}

model TenantCustomModule {
  subscriptionId String
  moduleId       String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module         AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, moduleId])
}

model TenantModule {
  id        String             @id @default(cuid())
  tenantId  String
  moduleId  String
  isEnabled Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    AppModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  access    ModuleRoleAccess[]

  @@unique([tenantId, moduleId])
  @@index([tenantId, isEnabled])
}

model ModuleRoleAccess {
  id             String       @id @default(cuid())
  tenantModuleId String
  role           Role
  isAllowed      Boolean      @default(false)
  tenantModule   TenantModule @relation(fields: [tenantModuleId], references: [id], onDelete: Cascade)

  @@unique([tenantModuleId, role])
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  name               String
  passwordHash       String
  sessionVersion     Int                     @default(0)
  role               Role                    @default(USER)
  isActive           Boolean                 @default(true)
  deactivatedAt      DateTime?
  tenantId           String?
  tenant             Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  moduleAccess       UserModuleAccess[]
  authSessions       AuthSession[]
  casesCreated       Case[]                  @relation("CaseCreator")
  casesAssigned      Case[]                  @relation("CaseAssignee")
  investigationNotes CaseInvestigationNote[] @relation("CaseNoteAuthor")
  evidenceCreated    CaseEvidence[]          @relation("CaseEvidenceCreator")
  asmNotificationReads AsmNotificationRead[]
  notificationRecipients NotificationRecipient[]
  @@unique([id, tenantId])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  version          Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model UserModuleAccess {
  userId      String
  tenantId    String
  moduleId    String
  featureKeys String[]  @default([])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, moduleId])
  @@index([tenantId, moduleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Indicator {
  id                   String                        @id @default(cuid())
  tenantId             String
  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value                String
  type                 IndicatorType
  severity             IndicatorSeverity             @default(MEDIUM)
  confidence           Int                           @default(50)
  status               IndicatorStatus               @default(ACTIVE)
  tags                 String[]                      @default([])
  source               String?
  intelligenceSourceId String?
  intelligenceSource   IntelligenceSource?           @relation(fields: [intelligenceSourceId], references: [id], onDelete: SetNull)
  description          String?
  expiresAt            DateTime?
  createdById          String?
  intelligenceEntityId String?
  intelligenceEntity   IntelligenceEntity?           @relation(fields: [intelligenceEntityId], references: [id], onDelete: SetNull)
  campaigns            CampaignIndicator[]
  intelligenceReports  IntelligenceReportIndicator[]
  enrichments          IndicatorEnrichment[]
  sourceObservations   IndicatorSourceObservation[]
  enrichmentJobs       IndicatorEnrichmentJob[]
  cases                CaseIndicator[]
  iocCandidates        IocCandidate[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([tenantId, type, value])
  @@unique([id, tenantId])
  @@index([tenantId, status, severity])
  @@index([tenantId, createdAt])
  @@index([tenantId, intelligenceEntityId])
  @@index([tenantId, intelligenceSourceId])
}

model IndicatorSourceObservation {
  id                   String              @id @default(cuid())
  tenantId             String
  indicatorId          String
  intelligenceSourceId String?
  sourceKey            String
  sourceName           String
  provider             String?
  origin               String
  firstSeenAt          DateTime            @default(now())
  lastSeenAt           DateTime            @default(now())
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicator            Indicator           @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Cascade)
  intelligenceSource   IntelligenceSource? @relation(fields: [intelligenceSourceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, indicatorId, sourceKey])
  @@index([tenantId, indicatorId])
  @@index([tenantId, intelligenceSourceId])
}

model IndicatorEnrichment {
  id          String                    @id @default(cuid())
  tenantId    String
  indicatorId String
  provider    String
  data        Json?
  status      IndicatorEnrichmentStatus
  error       String?
  createdAt   DateTime                  @default(now())
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicator   Indicator                 @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, indicatorId, createdAt])
}

model IndicatorEnrichmentJob {
  id            String                       @id @default(cuid())
  tenantId      String
  indicatorId   String
  provider      String                       @default("VIRUSTOTAL")
  trigger       String                       @default("TELEGRAM_APPROVAL")
  requestedById String?
  status        IndicatorEnrichmentJobStatus @default(PENDING)
  attempts      Int                          @default(0)
  availableAt   DateTime                     @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicator     Indicator                    @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, indicatorId, provider])
  @@index([status, availableAt])
  @@index([tenantId, status, availableAt])
}

model IntelligenceSource {
  id                   String                        @id @default(cuid())
  tenantId             String
  tenant               Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  sourceType           IntelligenceSourceType
  provider             String?
  url                  String?
  reliability          IntelligenceSourceReliability @default(C)
  confidence           Int                           @default(50)
  tlp                  TlpLevel                      @default(AMBER)
  status               IntelligenceSourceStatus      @default(ACTIVE)
  lastSyncAt           DateTime?
  telegramChatId       String?
  createdBy            String
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  indicators           Indicator[]
  indicatorObservations IndicatorSourceObservation[]
  intelligenceReports  IntelligenceReportSource[]
  telegramMessages     TelegramStagingMessage[]
  iocCandidates        IocCandidate[]
  telegramPollingState TelegramPollingState?

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@unique([telegramChatId])
  @@index([tenantId, sourceType, status, tlp])
  @@index([tenantId, updatedAt])
}

model TelegramStagingMessage {
  id                   String                   @id @default(cuid())
  tenantId             String
  intelligenceSourceId String
  telegramChatId       String
  channelUsername      String?
  channelTitle         String
  messageId            String
  updateId             String
  messageTimestamp     DateTime
  editTimestamp        DateTime?
  content              String
  text                 String?
  caption              String?
  entities             Json?
  messageUrl           String?
  ingestedAt           DateTime                 @default(now())
  processingStatus     TelegramProcessingStatus @default(PENDING)
  processingError      String?
  contentHash          String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intelligenceSource   IntelligenceSource       @relation(fields: [intelligenceSourceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  iocObservations      IocObservation[]

  @@unique([tenantId, telegramChatId, messageId])
  @@unique([tenantId, updateId])
  @@index([tenantId, processingStatus, ingestedAt])
  @@index([tenantId, intelligenceSourceId, messageTimestamp], map: "TelegramStagingMessage_tenantId_intelligenceSourceId_messageTim")
}

model IocCandidate {
  id                   String             @id @default(cuid())
  tenantId             String
  intelligenceSourceId String
  indicatorId          String?
  type                 IocCandidateType
  rawValue             String
  normalizedValue      String
  confidence           Int
  status               IocCandidateStatus @default(PENDING)
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  intelligenceSource   IntelligenceSource @relation(fields: [intelligenceSourceId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  indicator            Indicator?         @relation(fields: [indicatorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  observations         IocObservation[]

  @@unique([tenantId, type, normalizedValue])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, intelligenceSourceId])
  @@index([tenantId, indicatorId])
}

model IocObservation {
  id                       String                 @id @default(cuid())
  tenantId                 String
  candidateId              String
  telegramStagingMessageId String
  rawValue                 String
  extractionMethod         String
  spanStart                Int?
  spanEnd                  Int?
  observedAt               DateTime               @default(now())
  tenant                   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidate                IocCandidate           @relation(fields: [candidateId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)
  telegramStagingMessage   TelegramStagingMessage @relation(fields: [telegramStagingMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, candidateId, telegramStagingMessageId, extractionMethod, spanStart, spanEnd], map: "IocObservation_message_span_key")
  @@index([tenantId, telegramStagingMessageId])
}

model TelegramPollingState {
  id                   String             @id @default(cuid())
  tenantId             String
  intelligenceSourceId String
  lastUpdateId         String?
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intelligenceSource   IntelligenceSource @relation(fields: [intelligenceSourceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([intelligenceSourceId, tenantId])
  @@index([tenantId, updatedAt])
}

model IntelligenceEntity {
  id                    String                     @id @default(cuid())
  tenantId              String
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                  IntelligenceEntityType
  name                  String
  description           String?
  externalId            String?
  confidence            Int                        @default(50)
  severity              IndicatorSeverity          @default(MEDIUM)
  metadata              Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  outgoingRelationships IntelligenceRelationship[] @relation("RelationshipSource")
  incomingRelationships IntelligenceRelationship[] @relation("RelationshipTarget")
  caseLinks             CaseEntity[]
  alertLinks            AlertEntity[]
  indicators            Indicator[]
  threatActor           ThreatActor?

  @@unique([tenantId, type, name])
  @@index([tenantId, type, severity])
}

model ThreatActor {
  id                  String                          @id @default(cuid())
  tenantId            String
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityId            String                          @unique
  entity              IntelligenceEntity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  aliases             String[]                        @default([])
  motivation          String?
  targetSectors       String[]                        @default([])
  country             String?
  region              String?
  status              ThreatActorStatus               @default(ACTIVE)
  createdBy           String
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  campaigns           Campaign[]
  malwareTools        ThreatActorMalwareTool[]
  vulnerabilities     ThreatActorVulnerability[]
  intelligenceReports IntelligenceReportThreatActor[]
  cases               CaseThreatActor[]

  @@unique([tenantId, entityId])
  @@unique([id, tenantId])
  @@index([tenantId, status, updatedAt])
}

model Campaign {
  id                  String                       @id @default(cuid())
  tenantId            String
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  objective           String?
  status              CampaignStatus               @default(PLANNED)
  severity            IndicatorSeverity            @default(MEDIUM)
  confidence          Int                          @default(50)
  startDate           DateTime?
  endDate             DateTime?
  externalId          String?
  referenceUrl        String?
  threatActorId       String
  threatActor         ThreatActor                  @relation(fields: [threatActorId], references: [id], onDelete: Restrict)
  indicators          CampaignIndicator[]
  mitreTechniques     CampaignMitreTechnique[]
  malwareTools        CampaignMalwareTool[]
  vulnerabilities     CampaignVulnerability[]
  intelligenceReports IntelligenceReportCampaign[]
  cases               CaseCampaign[]
  createdBy           String
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, status, severity, updatedAt])
  @@index([tenantId, threatActorId])
}

model MalwareTool {
  id                  String                          @id @default(cuid())
  tenantId            String
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  type                MalwareToolType
  description         String?
  externalId          String?
  url                 String?
  threatActors        ThreatActorMalwareTool[]
  campaigns           CampaignMalwareTool[]
  vulnerabilities     MalwareToolVulnerability[]
  intelligenceReports IntelligenceReportMalwareTool[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, type, updatedAt])
}

model Vulnerability {
  id                  String                            @id @default(cuid())
  tenantId            String
  tenant              Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cveId               String
  name                String
  description         String?
  severity            IndicatorSeverity                 @default(MEDIUM)
  cvssScore           Float?
  url                 String?
  affectedProduct     String?
  affectedVersionStart String?
  affectedVersionEnd   String?
  affectedVersionExact String?
  source              String?
  correlations        AssetVulnerabilityCorrelation[]
  threatActors        ThreatActorVulnerability[]
  campaigns           CampaignVulnerability[]
  malwareTools        MalwareToolVulnerability[]
  intelligenceReports IntelligenceReportVulnerability[]
  appSecFindingLinks AppSecFindingVulnerability[]
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([tenantId, cveId])
  @@unique([id, tenantId])
  @@index([tenantId, severity, updatedAt])
}

model IntelligenceReport {
  id              String                            @id @default(cuid())
  tenantId        String
  tenant          Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  summary         String
  content         String
  reportType      IntelligenceReportType
  tlp             TlpLevel                          @default(AMBER)
  status          IntelligenceReportStatus          @default(DRAFT)
  publishedAt     DateTime?
