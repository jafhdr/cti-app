generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum IndicatorType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  EMAIL
}

enum IndicatorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  isActive      Boolean  @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())
  users         User[]
  auditLogs     AuditLog[]
  indicators    Indicator[]
  tenantModules TenantModule[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  deactivatedAt DateTime?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Indicator {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value       String
  type        IndicatorType
  severity    IndicatorSeverity @default(MEDIUM)
  confidence  Int              @default(50)
  status      IndicatorStatus  @default(ACTIVE)
  tags        String[]         @default([])
  source      String?
  description String?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, type, value])
  @@index([tenantId, status, severity])
  @@index([tenantId, createdAt])
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
  BETA
  DEPRECATED
}

enum SubscriptionPlan {
  FREE
  STANDARD
  PRO
  ENTERPRISE
}

model Module {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  description String?
  version     String        @default("1.0.0")
  status      ModuleStatus  @default(ACTIVE)
  isGlobalEnabled Boolean   @default(true)
  config      Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  entitlements ModuleEntitlement[]
  tenantModules TenantModule[]
  auditLogs   ModuleAuditLog[]
  globalConfigs GlobalModuleConfig[]
  moduleHealth ModuleHealth?
  
  @@index([code])
  @@index([status])
}

model ModuleEntitlement {
  id             String           @id @default(cuid())
  moduleId       String
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan
  isEnabled      Boolean          @default(true)
  quotaLimit     Int?
  quotaUsed      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  @@unique([moduleId, plan])
  @@index([plan])
}

model TenantModule {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId      String
  module        Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isEnabled     Boolean   @default(true)
  isOverride    Boolean   @default(false)
  overrideReason String?
  featureFlags  Json?
  config        Json?
  assignedBy    String?
  assignedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
}

model ModuleAuditLog {
  id        String    @id @default(cuid())
  moduleId  String?
  module    Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  userId    String?
  tenantId  String?
  action    String
  metadata  Json?
  createdAt DateTime  @default(now())
  
  @@index([moduleId, createdAt])
  @@index([userId, createdAt])
}

model ModuleHealth {
  id            String    @id @default(cuid())
  moduleId      String    @unique
  module        Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status        String    @default("unknown")
  errorRate     Float     @default(0)
  latency       Int       @default(0)
  queueBacklog  Int       @default(0)
  failureCount  Int       @default(0)
  lastChecked   DateTime  @default(now())
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([status])
}

model GlobalModuleConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}
