# Backend server
PORT=3001

# Native PostgreSQL on Windows
# Ganti postgres:postgres sesuai username/password PostgreSQL Anda.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cti?schema=public"

# Development secrets - change before production
JWT_ACCESS_SECRET="cti-dev-access-secret-change-me"
JWT_REFRESH_SECRET="cti-dev-refresh-secret-change-me"

FRONTEND_URL="http://localhost:3000"
