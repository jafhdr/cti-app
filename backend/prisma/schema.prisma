  description String
  type        String
  severity    AssetFindingSeverity
  status      AssetFindingStatus   @default(OPEN)
  source      String
  sourceKey   String
  evidence    Json?
  firstSeenAt DateTime             @default(now())
  lastSeenAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset                @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  alerts      Alert[]

  @@unique([tenantId, assetId, source, sourceKey])
  @@index([tenantId, assetId, status])
}

model AsmDiscoverySchedule {
  id              String    @id @default(cuid())
  tenantId        String
  assetId         String    @unique
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(1440)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lockedUntil     DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset     @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([assetId, tenantId])
  @@index([enabled, nextRunAt])
}

model AsmDiscoveryRun {
  id            String                @id @default(cuid())
  tenantId      String
  assetId       String
  status        AsmDiscoveryRunStatus @default(RUNNING)
  source        String
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  discovered    Int                   @default(0)
  created       Int                   @default(0)
  updated       Int                   @default(0)
  failed        Int                   @default(0)
  error         String?
  providers     String[]              @default([])
  snapshot      Json?
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset                 @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  changes       AsmExposureChange[]
  riskSnapshots AsmRiskSnapshot[]
  fingerprintObservations AsmServiceFingerprintObservation[]

  @@index([tenantId, assetId, startedAt])
  @@unique([id, tenantId])
}

model AsmRiskSnapshot {
  id                   String          @id @default(cuid())
  tenantId             String
  assetId              String
  runId                String
  critical             Int
  high                 Int
  medium               Int
  low                  Int
  total                Int
  score                Int
  previousScore        Int?
  trend                AsmRiskTrend
  highImpactFindingIds String[]        @default([])
  evaluatedAt          DateTime        @default(now())
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                Asset           @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  run                  AsmDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  alerts               Alert[]

  @@unique([runId, assetId])
  @@index([tenantId, assetId, evaluatedAt])
}

model AsmExposureChange {
  id            String          @id @default(cuid())
  tenantId      String
  assetId       String
  runId         String
  type          AsmChangeType
  entityKey     String
  previousValue String?
  currentValue  String?
  detectedAt    DateTime        @default(now())
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset           @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  run           AsmDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  alerts        Alert[]

  @@unique([runId, type, entityKey])
  @@index([tenantId, assetId, detectedAt])
}

enum MonitoringWatchKind {
  DOMAIN
  BRAND
  IDENTITY_HASH
}

enum MonitoringObservationKind {
  CREDENTIAL_EXPOSURE
  CORPORATE_DATA_EXPOSURE
  BRAND_IMPERSONATION
  PHISHING_DOMAIN
}

enum MonitoringFindingStatus {
  NEW
  UNDER_REVIEW
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
}

enum MonitoringCollectionStatus {
  QUEUED
  RUNNING
  RETRY
  SUCCEEDED
  FAILED
}

model MonitoringWatchlist {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind MonitoringWatchKind
  value String
  identityKeyVersion String?
  label String
  active Boolean @default(true)
  expiresAt DateTime?
  assetId String?
  assetTenantId String?
  asset Asset? @relation(fields: [assetId, assetTenantId], references: [id, tenantId], onDelete: SetNull)
  createdById String
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  matches MonitoringMatch[]

  @@unique([tenantId, kind, value])
  @@unique([id, tenantId])
  @@index([tenantId, active, expiresAt])
}

model MonitoringSource {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogSourceId String?
  catalogTenantId String?
  catalogSource IntelligenceSource? @relation(fields: [catalogSourceId, catalogTenantId], references: [id, tenantId], onDelete: SetNull)
  catalogName String
  catalogTlp TlpLevel
  providerKey String
  authorized Boolean @default(false)
  qaOnly Boolean @default(true)
  retentionDays Int @default(30)
  connectorVersion Int @default(1)
  collectionEnabled Boolean @default(false)
  collectionIntervalMinutes Int @default(60)
  nextCollectionAt DateTime?
  lastSuccessAt DateTime?
  lastFailureReason String?
  coverageLabel String?
  createdAt DateTime @default(now())
  observations MonitoringObservation[]
  collectionJobs MonitoringCollectionJob[]

  @@unique([tenantId, providerKey])
  @@unique([id, tenantId])
}

model MonitoringObservation {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceId String
  source MonitoringSource @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerEventKey String
  kind MonitoringObservationKind
  domain String?
  identityHash String?
  identityKeyVersion String?
  metadataCategory String
  evidenceRef String
  evidenceDigest String
  observedAt DateTime
  collectedAt DateTime?
  providerPublishedAt DateTime?
  collectionJobId String?
  collectionJobTenantId String?
  collectionJob MonitoringCollectionJob? @relation(fields: [collectionJobId, collectionJobTenantId], references: [id, tenantId], onDelete: SetNull)
  expiresAt DateTime
  tlp TlpLevel
  createdAt DateTime @default(now())
  matches MonitoringMatch[]

  @@unique([tenantId, sourceId, providerEventKey])
  @@unique([id, tenantId])
  @@index([tenantId, kind, observedAt])
  @@index([expiresAt])
}

model MonitoringCollectionJob {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceId String
  source MonitoringSource @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestId String @unique
  status MonitoringCollectionStatus @default(QUEUED)
  attempt Int @default(0)
  dueAt DateTime @default(now())
  leaseUntil DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  observationCount Int @default(0)
  failureReason String?
  collectionLatencyMs Int?
  processingLatencyMs Int?
  createdAt DateTime @default(now())
  observations MonitoringObservation[]

  @@unique([id, tenantId])
  @@index([status, dueAt])
  @@index([tenantId, sourceId, createdAt])
}

model MonitoringMatch {
  id String @id @default(cuid())
  tenantId String
  observationId String
  observation MonitoringObservation @relation(fields: [observationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  watchlistId String
  watchlist MonitoringWatchlist @relation(fields: [watchlistId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rule String
  confidence Int
  severity IndicatorSeverity
  finding MonitoringFinding?
  createdAt DateTime @default(now())

  @@unique([observationId, watchlistId])
  @@unique([id, tenantId])
  @@index([tenantId, confidence])
}

model MonitoringFinding {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchId String
  match MonitoringMatch @relation(fields: [matchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  status MonitoringFindingStatus @default(NEW)
  alertId String?
  alertTenantId String?
  alert Alert? @relation(fields: [alertId, alertTenantId], references: [id, tenantId], onDelete: SetNull)
  caseId String?
  caseTenantId String?
  case Case? @relation(fields: [caseId, caseTenantId], references: [id, tenantId], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews MonitoringReview[]

  @@unique([id, tenantId])
  @@unique([matchId, tenantId])
  @@index([tenantId, status, createdAt])
}

model MonitoringReview {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findingId String
  finding MonitoringFinding @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus MonitoringFindingStatus
  toStatus MonitoringFindingStatus
  reason String
  createdAt DateTime @default(now())

  @@index([tenantId, findingId, createdAt])
}
