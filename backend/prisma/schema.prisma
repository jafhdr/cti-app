  sourceAsset   Asset                 @relation("RelationshipSource", fields: [sourceAssetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  targetAsset   Asset                 @relation("RelationshipTarget", fields: [targetAssetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, sourceAssetId, targetAssetId, type, source], map: "AssetRelationship_tenantId_sourceAssetId_targetAssetId_type_sou")
  @@index([tenantId, rootAssetId])
  @@index([tenantId, sourceAssetId])
  @@index([tenantId, targetAssetId])
}

model AssetPortService {
  id          String              @id @default(cuid())
  tenantId    String
  assetId     String
  port        Int
  protocol    NetworkProtocol
  service     String?
  product     String?
  version     String?
  banner      String?
  source      String?
  correlations AssetVulnerabilityCorrelation[]
  status      PortDiscoveryStatus @default(UNKNOWN)
  firstSeenAt DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset               @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, assetId, protocol, port])
  @@unique([id, tenantId])
  @@index([tenantId, assetId, status])
  @@index([tenantId, protocol, port])
}

model AssetVulnerabilityCorrelation {
  id String @id @default(cuid())
  tenantId String
  assetId String
  serviceId String
  vulnerabilityId String
  confidence String
  status String @default("ACTIVE")
  matchReason String
  evidence Json
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  service AssetPortService @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "AssetVulnerabilityCorrelation_serviceId_fkey")
  vulnerability Vulnerability @relation(fields: [vulnerabilityId, tenantId], references: [id, tenantId], onDelete: Cascade)
  alerts Alert[]
  @@unique([tenantId, serviceId, vulnerabilityId], map: "AssetVulnerabilityCorrelation_tenantId_serviceId_vulnerabilityI")
  @@index([tenantId, assetId])
}

model AssetFinding {
  id          String               @id @default(cuid())
  tenantId    String
  assetId     String
  title       String
  description String
  type        String
  severity    AssetFindingSeverity
  status      AssetFindingStatus   @default(OPEN)
  source      String
  sourceKey   String
  evidence    Json?
  firstSeenAt DateTime             @default(now())
  lastSeenAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset                @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  alerts      Alert[]

  @@unique([tenantId, assetId, source, sourceKey])
  @@index([tenantId, assetId, status])
}

model AsmDiscoverySchedule {
  id String @id @default(cuid())
  tenantId String
  assetId String @unique
  enabled Boolean @default(false)
  intervalMinutes Int @default(1440)
  lastRunAt DateTime?
  nextRunAt DateTime?
  lockedUntil DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@unique([assetId, tenantId])
  @@index([enabled, nextRunAt])
}

model AsmDiscoveryRun {
  id String @id @default(cuid())
  tenantId String
  assetId String
  status AsmDiscoveryRunStatus @default(RUNNING)
  source String
  startedAt DateTime @default(now())
  completedAt DateTime?
  discovered Int @default(0)
  created Int @default(0)
  updated Int @default(0)
  failed Int @default(0)
  error String?
  providers String[] @default([])
  snapshot Json?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  changes AsmExposureChange[]
  riskSnapshots AsmRiskSnapshot[]
  @@index([tenantId, assetId, startedAt])
}

model AsmRiskSnapshot {
  id String @id @default(cuid())
  tenantId String
  assetId String
  runId String
  critical Int
  high Int
  medium Int
  low Int
  total Int
  score Int
  previousScore Int?
  trend AsmRiskTrend
  highImpactFindingIds String[] @default([])
  evaluatedAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  run AsmDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  alerts Alert[]
  @@unique([runId, assetId])
  @@index([tenantId, assetId, evaluatedAt])
}

model AsmExposureChange {
  id String @id @default(cuid())
  tenantId String
  assetId String
  runId String
  type AsmChangeType
  entityKey String
  previousValue String?
  currentValue String?
  detectedAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  run AsmDiscoveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  alerts Alert[]
  @@unique([runId, type, entityKey])
  @@index([tenantId, assetId, detectedAt])
}
